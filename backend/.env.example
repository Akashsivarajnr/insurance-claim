# Copy this file to ".env" and change the values. Never commit the real .env file.
# Generate a secret with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://insurance-claim-sable.vercel.app
MAX_UPLOAD_MB=5
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=claimflow
